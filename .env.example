# ==============================================================================
# Autonomous AI Job Pipeline — Environment Configuration Template
# Instructions:
# 1. Copy this file to .env:  cp .env.example .env
# 2. Populate each variable with your credentials.
# 3. In production, configure these as GitHub Secrets under Repository Settings.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM Evaluation Providers (Multi-Provider Fallback Waterfall)
# ------------------------------------------------------------------------------
# Google Gemini API Key (Primary: 1,500 free daily requests with 4.5s pacing)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Groq Cloud API Key (Secondary Fallback with auto-rotation)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-8b-8192
GROQ_ENSEMBLE_MODEL=openai/gpt-oss-120b

# OpenRouter API Key (Secondary Zero-Cost Consensus Tier with Groq)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free
OR_MODEL=meta-llama/llama-3.2-3b-instruct:free

# ------------------------------------------------------------------------------
# 2. Cloud Database Persistence (Turso Cloud / LibSQL Serverless)
# ------------------------------------------------------------------------------
# Turso Database URL (e.g., libsql://your-db-name-org.turso.io)
TURSO_DATABASE_URL=libsql://your-database-name.turso.io

# Turso Authentication Token (generate via: turso db tokens create <db-name>)
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# ------------------------------------------------------------------------------
# 3. Notification Engine (Multi-Channel Discord Control Room)
# ------------------------------------------------------------------------------
# Your existing catch-all / fallback webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# The 3 category webhooks
DISCORD_WEBHOOK_BIOMED=https://discord.com/api/webhooks/your_biomed_id/your_token
DISCORD_WEBHOOK_ECE=https://discord.com/api/webhooks/your_ece_id/your_token
DISCORD_WEBHOOK_SOFTWARE=https://discord.com/api/webhooks/your_software_id/your_token

# ------------------------------------------------------------------------------
# 4. Job Scrapers & Search APIs
# ------------------------------------------------------------------------------
# SerpApi Key for Google Jobs aggregation (250 searches/month free tier)
SERPAPI_API_KEY=your_serpapi_api_key_here

# Apify Platform API Token ($5/month free platform credits)
APIFY_TOKEN=your_apify_api_token_here

# Apify Actor IDs
LINKEDIN_ACTOR_ID=your_linkedin_actor_id_here
WELLFOUND_ACTOR_ID=your_wellfound_actor_id_here
NAUKRI_ACTOR_ID=your_naukri_actor_id_here

# Adzuna Developer API Credentials (Free 250 calls/month)
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here

# RapidAPI Key (Optional / secondary fallback)
RAPIDAPI_KEY=your_rapidapi_key_here
